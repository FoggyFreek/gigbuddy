PGHOST=localhost
PGDATABASE=gigbuddy
PGUSER=your_pg_user
PGPASSWORD=your_pg_password
PGPORT=5432
# Optional. Max pg connections per process; pg's own default is 10.
PG_POOL_MAX=
SERVER_PORT=3002
CLIENT_ORIGIN=http://localhost:5173
# debug | info | warn | error — defaults to info when unset or unrecognized.
LOG_LEVEL=info

# Set to `production` on deployed environments only (the CI deploy writes it).
# Leave unset locally: it hardens the security headers, tightens cookie flags,
# and enables the billing reconciliation scheduler.
# NODE_ENV=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3002/api/auth/callback

# Personal Microsoft Account sign-in (Entra app registration, "Personal
# Microsoft accounts only"). Optional — Microsoft sign-in is disabled when unset.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3002/api/auth/callback/microsoft
SESSION_SECRET=change-me-to-a-long-random-string
APP_URL=http://localhost:5173
ADMIN_EMAIL=your email

# Mollie payment integration (optional)
# MOLLIE_WEBHOOK_BASE_URL defaults to APP_URL when unset.
# In dev, set this to a public tunnel URL so Mollie can reach your local server.
MOLLIE_WEBHOOK_BASE_URL=
# Set true only for local/testing flows where Mollie cannot reach the webhook URL.
MOLLIE_DISABLE_WEBHOOK=false

# Platform billing (subscriptions) uses Mollie
# through the application-owned PaymentProvider port. Configure
# PLATFORM_MOLLIE_API_KEY in the secret store.
# Set true to stop the periodic billing reconciliation job. It only runs when
# NODE_ENV=production, so this is an escape hatch for a misbehaving deploy.
# BILLING_SCHEDULER_DISABLED=false

# Venue geocoding via Nominatim (OpenStreetMap). Enabled unless set to exactly
# `false`. Nominatim's usage policy requires an identifying User-Agent with
# contact details — override the `gigbuddy-server-geocoder/1.0` default on any
# deployed environment.
# GEOCODING_ENABLED=true
# GEOCODER_USER_AGENT=

# Place lookup via the TomTom Search API (POI Search), used by the venue address
# autocomplete and the "Look up address" enrichment. Platform-wide key, metered:
# /api/places/search answers 400 `Place search is not configured` while unset,
# and the search control degrades to plain manual entry.
TOMTOM_API_KEY=

# Link-page integration (the linkbuddy app, a separate repo/deploy). Optional —
# the "Edit link page" affordance stays hidden while unset. LINKPAGE_SECRET is
# the shared HMAC secret (same value as linkbuddy's GIGBUDDY_SYNC_SECRET);
# LINKPAGE_URL is linkbuddy's public origin (e.g. https://link.example.com).
LINKPAGE_SECRET=
LINKPAGE_URL=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@gigbuddy.app

# Local RustFS object storage (S3-compatible development service)
# Outside Docker (npm run dev:all): RUSTFS_ENDPOINT=localhost
# When S3_* is empty outside production, these values configure the live store.
RUSTFS_ENDPOINT=localhost
RUSTFS_PORT=9000
RUSTFS_USE_SSL=false
RUSTFS_ACCESS_KEY=accesskey
RUSTFS_SECRET_KEY=secretkey
RUSTFS_PRIVATE_BUCKET=gigbuddy

# Live tenant-object S3-compatible store. Local development may leave these
# empty to use RustFS above; production points them at private Backblaze B2.
# MinIO endpoints do not include https:// in S3_ENDPOINT.
S3_ENDPOINT=localhost
S3_CONTAINER_ENDPOINT=rustfs
S3_PORT=9000
S3_USE_SSL=false
S3_REGION=
S3_ACCESS_KEY=accesskey
S3_SECRET_KEY=secretkey
S3_BUCKET=gigbuddy-tenant

# Required at API startup. JSON maps key IDs to base64-encoded 32-byte AES keys.
# Keep recovery copies outside the application secret store.
INTEGRATION_SECRETS_KEYS=
INTEGRATION_SECRETS_ACTIVE_KEY_ID=

# Grafana Cloud observability (only used by the `alloy` compose service, which
# runs under the `observability` profile — not started by local dev). See
# observability/README.md. GCLOUD_RW_API_KEY is the only secret; the access
# policy behind it needs scopes: metrics:write, logs:write.
GCLOUD_HOSTED_METRICS_URL=
GCLOUD_HOSTED_METRICS_ID=
GCLOUD_HOSTED_LOGS_URL=
GCLOUD_HOSTED_LOGS_ID=
GCLOUD_RW_API_KEY=
GCLOUD_SCRAPE_INTERVAL=60s
