    SETTINGS["IntegrationsSection<br/>Shopify client ID, secret and domain"]
    MERCHPAGE["MerchPage<br/>configuration gate and dialog launchers"]
    IMPORTDIALOG["ShopifyImportDialog<br/>paged order review and account/product mapping"]
    PAYOUTDIALOG["ShopifyPayoutDialog<br/>API/custom payout review and manual settlement"]
    BANKDIALOG["BankStatementImportDialog<br/>refresh, match and reconcile payouts"]
    ACCOUNTS["DefaultAccountsFields<br/>Shopify clearing and fee accounts"]
  end
  FPROFILE --> SETTINGS
  FCONTEXT --> MERCHPAGE
  FCONTEXT --> BANKDIALOG
  FCONTEXT --> ACCOUNTS
  FMERCH --> IMPORTDIALOG
  FMERCH --> PAYOUTDIALOG
  FBANK --> BANKDIALOG
  MERCHPAGE --> IMPORTDIALOG
  MERCHPAGE --> PAYOUTDIALOG

  subgraph review["Review: generic behavior, maintainability and reuse"]
    GOOD["Strong generic core: encrypted credentials, configuration state, tenant scoping, injected fetchImpl and the typed request client are shared patterns."]
    TX["Strong accounting behavior: order imports, payout settlement and bank reconciliation converge on shared transaction and immutable-ledger services."]
    LARGE["Maintainability risk: shopifyPayoutService is 500+ lines and shopifyPaymentsRepository mixes orders, refunds, payouts, manual settlement and PayPal reconciliation."]
    REUSE["Reusable within Shopify: token acquisition and GraphQL normalization serve order import and payout flows. Cross-provider reuse is limited because Shopify DTOs and accounting decisions share the same services."]
    BOUNDARY["Boundary concern: PayPal payout persistence lives in shopifyPaymentsRepository; a provider-neutral commerce-settlement repository would make ownership clearer."]
  end
  CREDENTIALS -.-> GOOD
  SHARED -.-> TX
  PAYOUTSVC -.-> LARGE
  SHOPAPI -.-> REUSE
  RP25 -.-> BOUNDARY

