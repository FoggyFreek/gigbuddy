  PAYOUTSVC --> PAYOUTAPI
  BANKSVC --> BANKAPI

  subgraph frontendapi["Frontend API and shared state"]
    FPROFILE["src/api/profile.ts<br/>get/set/clear client ID and secret<br/>get/set domain"]
    FMERCH["src/api/merch.ts<br/>fetch/import orders<br/>list/refresh/create/settle payouts"]
    FBANK["src/api/bankImport.ts.refreshShopifyPayouts<br/>plus commitBankImport"]
    FCONTEXT["ProfileProvider + integrations utility<br/>isIntegrationConfigured('shopify')"]
  end
  PROFILEAPI --> FPROFILE
  ORDERAPI --> FMERCH
  IMPORTAPI --> FMERCH
  PAYOUTAPI --> FMERCH
  BANKAPI --> FBANK
  FPROFILE --> FCONTEXT

